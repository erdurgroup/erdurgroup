{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erdurgroup",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
