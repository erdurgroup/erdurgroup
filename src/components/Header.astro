---
import Logo from './Logo.astro';
const { home = false } = Astro.props;
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '');
const items = [
  { href: '/yazilar', label: 'yazılar' },
  { href: '/iletisim', label: 'iletişim' },
];
---
<header class="site-header">
  <div class="wrap">
    <Logo extra={home ? 'header-logo' : ''} />
    <nav class="nav" aria-label="Ana menü">
      {items.map((i) => (
        <a href={i.href} aria-current={path === i.href || path.startsWith(i.href + '/') ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
  </div>
</header>
