---
import Base from '../layouts/Base.astro';
import { S, socials, waLink, telLink, safeUrl } from '../lib';
const wa = waLink();
const tel = telLink();
const maps = safeUrl(S.contact.mapsUrl);
const mapsQuery = ((S.contact as Record<string, any>).mapsQuery || '').trim();
const mapEmbed = mapsQuery ? `https://www.google.com/maps?q=${encodeURIComponent(mapsQuery)}&hl=tr&z=16&output=embed` : '';
const mapOpen = mapsQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}` : maps;
// Adrese tıklayınca işletme adıyla sade bir Google araması açılır.
const addressSearch = ((S.contact as Record<string, any>).addressSearch || '').trim();
const addressHref = addressSearch ? `https://www.google.com/search?q=${encodeURIComponent(addressSearch)}` : maps;
const soc = socials();
const rows = [
  wa && { k: 'whatsapp', v: 'yaz', href: wa, ext: true },
  tel && { k: 'telefon', v: S.contact.phone, href: tel },
  S.contact.email && { k: 'e-posta', v: S.contact.email, href: `mailto:${S.contact.email}` },
  soc.length > 0 && { k: 'sosyal medya', social: soc },
  S.contact.address && { k: 'adres', v: S.contact.address, href: addressHref || '', ext: !!addressHref },
].filter(Boolean);
---
<Base title="İletişim" description="Erdur Group ile iletişime geçin.">
  <div class="wrap">
    <div class="page-top"><h1 class="display">iletişim</h1></div>
    <ul class="links">
      {rows.map((r) => (
        <li>
          {r.social ? (
            <div class="row">
              <span class="k">{r.k}</span>
              <span class="v v-links">
                {r.social.map((s) => <a href={s.url} rel="noopener noreferrer me" target="_blank">{s.name}</a>)}
              </span>
            </div>
          ) : r.href ? (
            <a href={r.href} rel={r.ext ? 'noopener noreferrer me' : undefined} target={r.ext ? '_blank' : undefined}>
              <span class="k">{r.k}</span><span class="v">{r.v}</span>
            </a>
          ) : (
            <div class="row"><span class="k">{r.k}</span><span class="v">{r.v}</span></div>
          )}
        </li>
      ))}
    </ul>

    {mapEmbed && (
      <section class="map" aria-label="Haritada konumumuz">
        <div class="map-frame">
          <iframe
            src={mapEmbed}
            title={`Google Haritalar: ${mapsQuery}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        {mapOpen && (
          <a class="map-open" href={mapOpen} target="_blank" rel="noopener noreferrer">google haritalar'da aç / yol tarifi al <span aria-hidden="true">↗</span></a>
        )}
      </section>
    )}
  </div>
</Base>
